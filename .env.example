# --- Database ---------------------------------------------------------------
# SQLite file, relative to the prisma/ directory
DATABASE_URL="file:../data/app.db"

# --- Travelpayouts / Aviasales Data API ----------------------------------------
# Free: sign up at https://www.travelpayouts.com, join the Aviasales program,
# then copy the token from Profile -> API token
TRAVELPAYOUTS_TOKEN=""
# Market of the cached price data: us, de, gb, fr, es, it, ru, ...
TRAVELPAYOUTS_MARKET="us"

# --- Email (Resend) -----------------------------------------------------------
# Get an API key at https://resend.com
RESEND_API_KEY=""
# Must be a verified domain sender, or use onboarding@resend.dev for testing
ALERT_EMAIL_FROM="Flight Alerts <onboarding@resend.dev>"
ALERT_EMAIL_TO="you@example.com"

# --- Politeness / anti-ban ----------------------------------------------------
# Minimum delay between Amadeus API calls in ms (jitter is added on top)
REQUEST_DELAY_MS="600"
# Hard cap on Amadeus API requests per UTC day (worker skips checks once hit)
DAILY_REQUEST_BUDGET="500"
# Optional custom User-Agent for API requests
USER_AGENT=""

# --- Dashboard ----------------------------------------------------------------
PORT="3000"
